data/ingesta_estado.json
# dataset externo de validación (EUvsDisinfo/Zenodo), descargado por tests/validacion_externa.py
data/euvsdisinfo_base.csv
# muestras de validación curada (tests/export_validacion.py; se regeneran y las etiqueta el analista).
# Se versiona SOLO el historial (muestra,banda,n,coord,no,dud,precision): es la serie de
# precisión por banda que publica la card del dashboard, y sin git se perdería con el
# servidor. Las muestras con URLs/textos y el dataset EUvsDisinfo siguen fuera.
data/validacion/*
!data/validacion/historial.csv
